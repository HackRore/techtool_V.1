        ]
      },
      {
        "id": "high-usage",
        "question": "Identify the process causing high usage. Is it a known app?",
        "options": [
          { "label": "Yes - Browser/App", "next": "app-fix" },
          { "label": "No - System/Unknown", "next": "malware-scan" }
        ]
      },
      {
        "id": "resolved",
        "message": "Performance Restored.",
        "isFinal": true
      }
    ]
