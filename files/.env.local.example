# ─────────────────────────────────────────────────────
# HackRore TechWorkbench — Environment Variables
# ─────────────────────────────────────────────────────
#
# SETUP STEPS:
#   1. Copy this file: cp .env.local.example .env.local
#   2. Fill in your Anthropic API key below
#   3. NEVER commit .env.local to Git (it's in .gitignore)
#
# Get your key at: https://console.anthropic.com/
#
# ─────────────────────────────────────────────────────

# Required for AI Diagnosis feature in ScanLab
# Server-side only — NEVER use NEXT_PUBLIC_ prefix here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────────────────
# On Vercel: add this in Project → Settings → Environment Variables
# Key:   ANTHROPIC_API_KEY
# Value: sk-ant-your-key-here
# ─────────────────────────────────────────────────────
